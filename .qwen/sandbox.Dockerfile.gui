# CycleDesign Development Sandbox with GUI Support
# Custom sandbox image for Qwen Code with VNC, Chromium, and chrome-devtools-mcp
# Based on official Qwen Code sandbox image
# https://github.com/QwenLM/qwen-code

# =============================================================================
# Stage 1: Base Qwen Sandbox Image
# =============================================================================
FROM ghcr.io/qwenlm/qwen-code:latest AS base

# =============================================================================
# Stage 2: GUI-Enhanced Sandbox
# =============================================================================
FROM base AS gui-enhanced

# Set environment variables
ENV DISPLAY=:99 \
    DISPLAY_WIDTH=1920 \
    DISPLAY_HEIGHT=1080 \
    VNC_PORT=5900 \
    NOVEC_PORT=6080 \
    CHROME_DEBUGGING_PORT=9222 \
    DEBIAN_FRONTEND=noninteractive

# =============================================================================
# Install GUI Components (VNC, X11, noVNC, NGINX)
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # X11 Server and VNC
    xvfb \
    x11vnc \
    socat \
    \
    # Window Manager (lightweight)
    openbox \
    obconf \
    \
    # Terminal emulator for GUI
    xterm \
    \
    # noVNC dependencies
    novnc \
    websockify \
    \
    # NGINX for serving noVNC web interface
    nginx \
    \
    # Font support
    fonts-noto-cjk \
    fonts-dejavu-core \
    xfonts-base \
    xfonts-100dpi \
    xfonts-75dpi \
    xfonts-scalable \
    \
    # Additional utilities
    dbus-x11 \
    xdg-utils \
    wmctrl \
    xdotool \
    \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* \
    && rm -rf /var/tmp/*

# =============================================================================
# Install Chromium Browser
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    \
    # Chromium dependencies for headless operation
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* \
    && rm -rf /var/tmp/*

# =============================================================================
# Install chrome-devtools-mcp server
# =============================================================================
RUN npm install -g chrome-devtools-mcp \
    && npm cache clean --force

# =============================================================================
# Configure NGINX for noVNC
# =============================================================================
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/lib/nginx/body /etc/nginx/conf.d \
    && chown -R node:node /var/log/nginx /var/cache/nginx /var/lib/nginx \
    && rm -f /etc/nginx/sites-enabled/default

# Create custom nginx.conf for non-root operation
COPY <<'EOF' /etc/nginx/nginx.conf
worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    sendfile on;
    keepalive_timeout 65;

    include /etc/nginx/conf.d/*.conf;
}
EOF

COPY <<'EOF' /etc/nginx/conf.d/novnc.conf
server {
    listen 6080;
    server_name localhost;

    root /usr/share/novnc;
    index vnc.html;

    location / {
        try_files $uri $uri/ /vnc.html;
    }

    location /websockify {
        proxy_pass http://127.0.0.1:6081/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}
EOF

# =============================================================================
# Create startup scripts
# =============================================================================

# Main entrypoint script
COPY <<'EOF' /usr/local/bin/start-gui
#!/bin/bash
set -e

echo "=== CycleDesign GUI Sandbox Starting ==="
echo "Display: $DISPLAY"
echo "Resolution: ${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}"
echo "VNC Port: $VNC_PORT"
echo "noVNC Web Interface: http://localhost:$NOVEC_PORT"
echo "Chrome Debugging Port: $CHROME_DEBUGGING_PORT"

# Start D-Bus (required for many GUI apps)
# Use sudo if available, otherwise skip (running in container without privileges)
if [ ! -d /var/run/dbus ]; then
    mkdir -p /var/run/dbus 2>/dev/null || true
fi
dbus-daemon --system --fork 2>/dev/null || true

# Start Xvfb (virtual framebuffer)
Xvfb $DISPLAY -screen 0 ${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}x24 -ac +extension GLX +render -noreset &
XVFB_PID=$!
echo "Xvfb started (PID: $XVFB_PID)"

# Wait for X server to be ready
sleep 2

# Set display permissions
xhost +local: 2>/dev/null || true

# Start Openbox window manager
openbox --config-file /etc/xdg/openbox/rc.xml &
OPENBOX_PID=$!
echo "Openbox started (PID: $OPENBOX_PID)"

# Start x11vnc server
x11vnc -display $DISPLAY \
    -forever \
    -shared \
    -rfbport $VNC_PORT \
    -nopw \
    -listen 0.0.0.0 \
    &
VNC_PID=$!
echo "x11vnc started (PID: $VNC_PID)"

# Start websockify for noVNC
websockify 6081 localhost:$VNC_PORT &
WEBSOCKIFY_PID=$!
echo "websockify started (PID: $WEBSOCKIFY_PID)"

# Start NGINX for noVNC web interface
nginx -g 'daemon off;' &
NGINX_PID=$!
echo "NGINX started (PID: $NGINX_PID)"

# Start Chromium in debug mode (background)
mkdir -p /tmp/chrome-profile
chromium \
    --no-sandbox \
    --disable-dev-shm-usage \
    --disable-gpu \
    --remote-debugging-port=9222 \
    --user-data-dir=/tmp/chrome-profile \
    --disable-background-networking \
    --disable-default-apps \
    --disable-extensions \
    --disable-sync \
    --no-first-run \
    about:blank &
CHROME_PID=$!
echo "Chromium started (PID: $CHROME_PID)"

# Forward Chrome debugging port to 0.0.0.0 for external access
socat TCP-LISTEN:9222,reuseaddr,fork TCP:127.0.0.1:9222 &
SOCAT_PID=$!
echo "Chrome port forward started (PID: $SOCAT_PID)"

echo ""
echo "=== Services Started ==="
echo "- VNC Server: localhost:$VNC_PORT"
echo "- noVNC Web UI: http://localhost:$NOVEC_PORT/vnc.html?host=localhost&port=6081"
echo "- Chrome DevTools: http://localhost:$CHROME_DEBUGGING_PORT"
echo ""
echo "To connect:"
echo "  1. VNC Client: Connect to localhost:$VNC_PORT (no password)"
echo "  2. Browser: Open http://localhost:$NOVEC_PORT"
echo "  3. Chrome DevTools: http://localhost:$CHROME_DEBUGGING_PORT/json"
echo ""
echo "chrome-devtools-mcp is available via: npx chrome-devtools-mcp"
echo "Set CHROME_DEBUGGING_PORT=$CHROME_DEBUGGING_PORT in your MCP config"
echo ""

# Keep container running and forward signals
trap "kill -TERM $XVFB_PID $OPENBOX_PID $VNC_PID $WEBSOCKIFY_PID $NGINX_PID $CHROME_PID $SOCAT_PID 2>/dev/null; exit 0" TERM INT

# Wait for all background processes
wait
EOF

RUN chmod +x /usr/local/bin/start-gui

# =============================================================================
# Create MCP configuration helper
# =============================================================================
COPY <<'EOF' /usr/local/bin/configure-chrome-mcp
#!/bin/bash
# Helper script to configure chrome-devtools-mcp in various MCP clients

MCP_CONFIG="${1:-$HOME/.qwen/settings.json}"

cat <<MCP_EOF
{
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp"],
        "env": {
          "CHROME_DEBUGGING_PORT": "9222"
        }
      }
    }
  }
}
MCP_EOF

echo ""
echo "Add the above JSON to your MCP configuration file:"
echo "  - Qwen Code: ~/.qwen/settings.json or .qwen/settings.json in project"
echo "  - VS Code: User settings JSON"
echo "  - OpenCode: ~/.config/opencode/opencode.json"
echo ""
echo "Or run: configure-chrome-mcp >> your-config.json"
EOF

RUN chmod +x /usr/local/bin/configure-chrome-mcp

# =============================================================================
# Create convenience script for testing Chrome DevTools connection
# =============================================================================
COPY <<'EOF' /usr/local/bin/test-chrome-connection
#!/bin/bash
echo "Testing Chrome DevTools Protocol connection..."
echo ""

# Check if Chrome is running
if curl -s http://localhost:9222/json/version > /dev/null 2>&1; then
    echo "✅ Chrome is running and accessible"
    echo ""
    echo "Chrome Version Info:"
    curl -s http://localhost:9222/json/version | jq .
    echo ""
    echo "Available Targets:"
    curl -s http://localhost:9222/json/list | jq '.[] | {title, url, type}'
    echo ""
    echo "✅ Chrome DevTools Protocol is ready!"
    echo ""
    echo "You can now use chrome-devtools-mcp with:"
    echo "  npx chrome-devtools-mcp"
    echo ""
    echo "Or configure it in your MCP client settings."
else
    echo "❌ Chrome is not responding on port 9222"
    echo ""
    echo "Troubleshooting:"
    echo "  1. Make sure the GUI sandbox is started: start-gui"
    echo "  2. Check if Chromium is running: ps aux | grep chromium"
    echo "  3. Check Chrome debugging endpoint: curl http://localhost:9222/json/version"
    exit 1
fi
EOF

RUN chmod +x /usr/local/bin/test-chrome-connection

# =============================================================================
# Set working directory and user
# =============================================================================
USER node
WORKDIR /home/node/app

# =============================================================================
# Expose ports
# =============================================================================
EXPOSE 5900
EXPOSE 6080
EXPOSE 9222

# =============================================================================
# Default command
# =============================================================================
CMD ["start-gui"]

# =============================================================================
# Labels for documentation
# =============================================================================
LABEL maintainer="CycleDesign Team"
LABEL description="Qwen Code sandbox with GUI support (VNC, noVNC, Chromium, chrome-devtools-mcp)"
LABEL version="1.0.0"
LABEL features="VNC,noVNC,Chromium,chrome-devtools-mcp,X11,openbox"
