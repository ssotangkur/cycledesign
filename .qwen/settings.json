{
  "$schema": "https://qwenlm.github.io/qwen-code-docs/en/developers/schemas/mcp-settings.json",
  "sandbox": {
    "image": "cycledesign-sandbox:gui",
    "docker": {
      "runArgs": [
        "-p", "5900:5900",
        "-p", "6080:6080",
        "-p", "9222:9222"
      ]
    }
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ],
      "timeout": 60000,
      "trust": true
    }
  },
  "$version": 3
}
