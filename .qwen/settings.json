{
    "$version": 3,
    "mcpServers": {
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "chrome-devtools-mcp@latest",
                "--browser-url=http://127.0.0.1:9222"
            ],
            "timeout": 60000,
            "trust": true
        },
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GH_TOKEN}"
            },
            "timeout": 60000,
            "trust": true
        }
    }
}