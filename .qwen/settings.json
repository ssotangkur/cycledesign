{
    "$version": 3,
    "mcpServers": {
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "chrome-devtools-mcp@latest",
                "--browser-url=http://127.0.0.1:9222"
            ],
            "timeout": 60000,
            "trust": true
        },
        "github": {
            "type": "stdio",
            "command": "go",
            "args": [
                "run",
                "github.com/github/github-mcp-server/cmd/github-mcp-server@latest",
                "stdio"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
            },
            "timeout": 60000,
            "trust": true
        }
    }
}