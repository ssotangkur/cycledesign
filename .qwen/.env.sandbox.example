# Sandbox Port Configuration
# Copy this file to .env.sandbox and customize for your worktree
# .env.sandbox is git-ignored, so each worktree can have different ports

# Host port for noVNC web interface (default: 6080)
# Access the sandbox GUI at http://localhost:<NOVNC_PORT>
NOVNC_PORT=6080

# Host port for VNC server (default: 5900)
# Connect with VNC client at localhost:<VNC_PORT>
VNC_PORT=5900

# Host port for Chrome DevTools remote debugging (default: 9222)
# Used internally by chrome-devtools-mcp
CHROME_PORT=9222

# =============================================================================
# Multi-Sandbox Setup
# =============================================================================
# To run multiple sandboxes simultaneously, use different ports for each:
#
# Worktree 1 (main): Keep defaults above (6080, 5900, 9222)
# Worktree 2 (feature): Uncomment and use these instead:
# NOVNC_PORT=6081
# VNC_PORT=5901
# CHROME_PORT=9223
#
# Worktree 3 (another): Use these:
# NOVNC_PORT=6082
# VNC_PORT=5902
# CHROME_PORT=9224
# =============================================================================
