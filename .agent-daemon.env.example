# CycleDesign agent-daemon settings (git-ignored).
# Copy to `.agent-daemon.env` and adjust values, then restart the daemon.
# The daemon exits 2 with setup instructions when `.agent-daemon.env` is missing.
#
# Daemon owns `--model` per `opencode run` spawn: FREE_MODEL by default,
# GO_MODEL after a gateway-quota failover. The absent static `"model"` pin in
# `opencode.jsonc` stays absent (verify-and-keep-absent).

# Free-tier-first default model (provider/model for `opencode run --model`).
FREE_MODEL=opencode/muse-spark-1.3-contributor-free

# Failover model used after gateway-quota exhaustion.
GO_MODEL=opencode-go/muse-spark-1.3-contributor

# Watchdog: kill + investigate after this many seconds with zero non-error
# `--format json` lines from the running CLI.
STUCK_TIMEOUT_S=900

# Failback probe: while on GO_MODEL, probe the free tier this often (seconds),
# at run boundaries only. First successful probe flips subsequent runs to free.
PROBE_INTERVAL_S=900

# Timeout (seconds) for a single free-tier probe
# (`opencode run --model <FREE_MODEL> "return the single word OK"`).
PROBE_TIMEOUT_S=90

# Sandbox mode (#121): 1 runs each worker in a disposable Docker Sandbox
# microVM via `sbx` (survives host process killers like GameGuard).
# Off by default (host-direct spawn). Requires `sbx login` + one-time
# `sbx policy init balanced` on the host (see SANDBOX.md).
SANDBOX_MODE=0

# Override the sbx binary location (default: %LOCALAPPDATA%\DockerSandboxes\bin\sbx.exe on Windows, `sbx` on PATH elsewhere).
# SBX_BIN=sbx

# Sandbox template: universal worker image built from sbx/sandbox.Dockerfile
# (opencode + GUI/VNC + Chromium + chrome-devtools-mcp). Build + load once:
#   docker build -f sbx/sandbox.Dockerfile -t cycledesign-worker .
#   docker save cycledesign-worker | sbx template load   (see `sbx template load --help`)
SBX_TEMPLATE=cycledesign-worker

# Project board mirror (#140): GH_TOKEN (or host `gh` login) needs the
# `project` scope or the board Status mirror fails (labels still drive the
# daemon; the board just drifts). The daemon preflights read-only
# `project view` + `field-list` at boot and exits 2 with the fix when the
# scope is missing; a mid-run board outage only warns.
# Fix when preflight fails:
#   gh auth refresh -s project
# Or export a token that already has it:
#   GH_TOKEN=<token-with-project-scope>
# Custom board (forwarded into sandbox workers as well):
#   PROJECT_OWNER=ssotangkur
#   PROJECT_NUMBER=1
