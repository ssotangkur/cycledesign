{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "**/ecosystem.config.js",
    "**/scripts/tee.js",
    "**/eslint.config.js",
    ".qwen/skills/chat-log-parser/scripts/parse-chat-log.ts"
  ],
  "ignoreDependencies": [
    "zod",
    "kill-port",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "@types/diff",
    "@design/app"
  ],
  "ignoreWorkspaces": [
    "packages/design-system-runtime"
  ],
  "workspaces": {
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"]
    }
  }
}
